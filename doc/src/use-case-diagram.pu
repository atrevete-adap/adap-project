@startuml
left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}
skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
}
skinparam arrow {
    Color #2B3E6A
}

title Turbine — Internal Invoicing & Payment Tracking System (Submission 1)

'=== Actors ===
' Primary actors (internal staff). Generalization: every Administrator can do what
' an Operational User does, and every Super Administrator what an Administrator does.
actor "Operational User\n(Reader / Assigned Staff)" as OpUser
actor "Administrator" as Admin
actor "Super Administrator" as SuperAdmin
Admin -|> OpUser
SuperAdmin -|> Admin

' Primary actors (non-human initiators)
actor "Time" as Time <<timer>>
actor "External Application\n(Brain / API client)" as ExtApp

' Secondary (supporting) actors — simulated in this exercise
actor "Payment Provider\n(Stripe / Revolut)" as PayProv <<system>>
actor "Communication Service\n(Email / WhatsApp)" as CommSrv <<system>>

'=== System Boundary ===
rectangle "Turbine Invoicing & Collections System" {
    '=== Use Cases ===
    ' Access and administration
    usecase "UC-01 Access the\ninternal application" as UC01
    usecase "UC-04 Manage internal\nuser accounts" as UC04
    usecase "UC-05 Assign and\ndelegate customers" as UC05
    usecase "UC-18 Configure billing and\nautomation policies" as UC18
    usecase "UC-19 Inspect audit and\nautomation health" as UC19
    usecase "UC-20 Create and\nrestore a backup" as UC20

    ' Customers and subscriptions
    usecase "UC-02 Maintain customer\nand contact records" as UC02
    usecase "UC-03 Import customers\nfrom CSV" as UC03
    usecase "UC-06 Manage a monthly\nsubscription" as UC06
    usecase "UC-07 Review the annual\nrevenue band and rate" as UC07
    usecase "UC-15 Record a subscription\ncancellation" as UC15
    usecase "UC-16 Query a customer's\noutstanding obligations" as UC16

    ' Invoicing
    usecase "UC-08 Prepare a\none-off invoice" as UC08
    usecase "UC-09 Issue an invoice" as UC09
    usecase "UC-10 Generate monthly\nrecurring invoices" as UC10
    usecase "UC-11 Deliver an\nissued invoice" as UC11
    usecase "UC-21 Correct an\nissued invoice" as UC21
    usecase "UC-23 Decide a sensitive\nfinancial approval" as UC23
    usecase "UC-24 Close or reopen an\nadministrative period" as UC24

    ' Collections and follow-up
    usecase "UC-12 Reconcile a payment\nwith an invoice" as UC12
    usecase "UC-13 Run invoice reminders\nand overdue follow-up" as UC13
    usecase "UC-14 Review assigned work\nand internal notifications" as UC14
    usecase "UC-22 Resolve a billing\nor delivery issue" as UC22
    usecase "UC-17 Consult financial\ndashboard and reports" as UC17
}

'=== Relationships ===
' Operational User (inherited by Administrator and Super Administrator)
OpUser --> UC01
OpUser --> UC02
OpUser --> UC06
OpUser --> UC08
OpUser --> UC09
OpUser --> UC12
OpUser --> UC14
OpUser --> UC22

' Administrator
Admin --> UC03
Admin --> UC05
Admin --> UC07
Admin --> UC15
Admin --> UC17
Admin --> UC21
Admin --> UC23
Admin --> UC24

' Super Administrator
SuperAdmin --> UC04
SuperAdmin --> UC18
SuperAdmin --> UC19
SuperAdmin --> UC20

' Time-triggered processes
Time --> UC07
Time --> UC10
Time --> UC12
Time --> UC13
Time --> UC20

' External application (API)
ExtApp --> UC15
ExtApp --> UC16

' Secondary actors
UC12 --> PayProv
UC11 --> CommSrv
UC13 --> CommSrv

' <<include>>: behavior that is ALWAYS reused
UC10 ..> UC09 : <<include>>
UC21 ..> UC09 : <<include>>
UC09 ..> UC11 : <<include>>
UC15 ..> UC16 : <<include>>

' <<extend>>: optional behavior inserted under a condition
UC09 ..> UC06 : <<extend>>\n(mid-month start:\nprorated invoice)
UC23 ..> UC08 : <<extend>>\n(amount or discount\nabove threshold)
UC23 ..> UC06 : <<extend>>\n(commercial exception\nor discount)
UC23 ..> UC21 : <<extend>>\n(correction above\nthreshold)
UC22 ..> UC11 : <<extend>>\n(delivery bounced)
UC22 ..> UC12 : <<extend>>\n(no clear reference or\namount mismatch)

'=== Notes (quality constraints, not use cases) ===
note right of UC01
  Authentication is a precondition of every
  staff use case (corporate e-mail domain only).
  Every action rechecks role and customer scope.
  NFR-04
end note

note bottom of UC10
  Idempotent: one invoice per subscription
  and billing period; recoverable after
  downtime. NFR-06
end note

note bottom of UC17
  Responsive & accessible (WCAG 2.1 AA),
  P95 < 2 s with 5,000 customers.
  NFR-02, NFR-03
end note

@enduml
