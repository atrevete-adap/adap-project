' Turbine: 18 stable UC IDs, in four views of the same system.
' Absorbed IDs: UC-03 -> UC-02; UC-05 -> UC-04; UC-07 -> UC-06;
' UC-09 and UC-11 -> UC-08; UC-19 -> UC-20. No functional scope removed.
' Repeated ellipses are the same case; see the Markdown contracts for branches.

@startuml use-case-diagram-1-administration
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam note {
  BackgroundColor #FDE2B8
  BorderColor #2B3E6A
}
skinparam arrow {
  Color #2B3E6A
}
title View 1 - Access and administration

actor "Operational User\n(Reader / Assigned Staff)" as OpUser
actor "Administrator" as Admin
actor "Super Administrator" as SuperAdmin
actor "Time" as Time <<timer>>
actor "Communication Service\n(Email / WhatsApp, simulated)" as CommSrv <<system>>

rectangle "Turbine Invoicing & Collections System" {
  usecase "UC-01 Access the internal\napplication" as UC01
  usecase "UC-04 Administer staff access\nand customer assignments" as UC04
  usecase "UC-17 Consult financial\ndashboard and reports" as UC17
  usecase "UC-18 Configure billing and\nautomation policies" as UC18
  usecase "UC-20 Supervise audit,\nbackups and recovery" as UC20
  usecase "UC-24 Close or reopen an\nadministrative period" as UC24
}

Admin -|> OpUser
SuperAdmin -|> Admin
OpUser --> UC01
Admin --> UC04
SuperAdmin --> UC04
Admin --> UC17
Admin --> UC24
SuperAdmin --> UC18
SuperAdmin --> UC20
Time --> UC20 : scheduled backup
Time --> UC17 : authorised summary
UC01 --> CommSrv : recovery email
UC04 --> CommSrv : activation
UC17 --> CommSrv : internal summary

note bottom of UC04
  Account changes require the specific
  FR6.3 grant; assignments require
  Administrator authority.
end note

note bottom of UC20
  Audit is read-only; only Super Administrator
  can restore. Time only creates backups.
  NFR-05, NFR-06
end note

@enduml

@startuml use-case-diagram-2-customers
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam note {
  BackgroundColor #FDE2B8
  BorderColor #2B3E6A
}
skinparam arrow {
  Color #2B3E6A
}
title View 2 - Customers and subscriptions

actor "Operational User\n(Reader / Assigned Staff)" as OpUser
actor "Administrator" as Admin
actor "Time" as Time <<timer>>
actor "External Application\n(Brain / API client)" as ExtApp

rectangle "Turbine Invoicing & Collections System" {
  usecase "UC-02 Maintain customers\nand import records" as UC02
  usecase "UC-06 Manage subscriptions\nand annual rate reviews" as UC06
  usecase "UC-15 Record subscription\ncancellation" as UC15
  usecase "UC-16 Query outstanding obligations\nthrough the API" as UC16
  usecase "UC-08 Prepare, issue and\ndeliver an invoice" as UC08
  usecase "UC-23 Decide a sensitive\nfinancial approval" as UC23
}

Admin -|> OpUser
OpUser --> UC02
Admin --> UC02 : CSV branch
OpUser --> UC06
Admin --> UC06 : annual review
Time --> UC06 : review due
Admin --> UC15
ExtApp --> UC15 : intake only
ExtApp --> UC16
Admin --> UC23
UC15 ..> UC16 : <<include>>
UC08 ..> UC06 : <<extend>>\n(initial proration due)
UC23 ..> UC06 : <<extend>>\n(rate or commercial approval)

note bottom of UC02
  CSV import remains an
  Administrator-only branch.
end note

note bottom of UC15
  Cancellation stops future recurrence;
  previous debt remains collectible.
  C4; FR4, FR4.1
end note

@enduml

@startuml use-case-diagram-3-invoicing
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam note {
  BackgroundColor #FDE2B8
  BorderColor #2B3E6A
}
skinparam arrow {
  Color #2B3E6A
}
title View 3 - Invoicing

actor "Operational User\n(Reader / Assigned Staff)" as OpUser
actor "Administrator" as Admin
actor "Time" as Time <<timer>>
actor "Communication Service\n(Email / WhatsApp, simulated)" as CommSrv <<system>>

rectangle "Turbine Invoicing & Collections System" {
  usecase "UC-08 Prepare, issue and\ndeliver an invoice" as UC08
  usecase "UC-10 Generate monthly\nrecurring invoices" as UC10
  usecase "UC-21 Correct an\nissued invoice" as UC21
  usecase "UC-23 Decide a sensitive\nfinancial approval" as UC23
}

Admin -|> OpUser
OpUser --> UC08
Admin --> UC21
Admin --> UC23
Time --> UC10
UC08 --> CommSrv
UC10 ..> UC08 : <<include>>
UC21 ..> UC08 : <<include>>
UC23 ..> UC08 : <<extend>>\n(sensitive proposal)
UC23 ..> UC21 : <<extend>>\n(correction threshold)

note bottom of UC08
  Preparation, issuance, PDF and delivery
  are phases of one contract. Included callers
  supply an authorised proposal.
  Failed dispatch never renumbers an invoice.
end note

note bottom of UC10
  Idempotent per subscription and period;
  recover only missing work. NFR-06
end note

@enduml

@startuml use-case-diagram-4-collections
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam note {
  BackgroundColor #FDE2B8
  BorderColor #2B3E6A
}
skinparam arrow {
  Color #2B3E6A
}
title View 4 - Collections and follow-up

actor "Operational User\n(Reader / Assigned Staff)" as OpUser
actor "Time" as Time <<timer>>
actor "Payment Provider\n(Stripe / Revolut, simulated)" as PayProv <<system>>
actor "Communication Service\n(Email / WhatsApp, simulated)" as CommSrv <<system>>

rectangle "Turbine Invoicing & Collections System" {
  usecase "UC-08 Prepare, issue and\ndeliver an invoice" as UC08
  usecase "UC-12 Reconcile payments\nwith invoices" as UC12
  usecase "UC-13 Run reminders and\noverdue follow-up" as UC13
  usecase "UC-14 Review daily work\nand notifications" as UC14
  usecase "UC-22 Resolve a billing\nor delivery issue" as UC22
}

OpUser --> UC08 : delivery retry
OpUser --> UC12
OpUser --> UC14
OpUser --> UC22
Time --> UC12
Time --> UC13
UC08 --> CommSrv
UC13 --> CommSrv
UC12 --> PayProv
UC22 ..> UC08 : <<extend>>\n(delivery problem)
UC22 ..> UC12 : <<extend>>\n(reconciliation problem)

note bottom of UC13
  Customer terms override the default.
  C9 moves messages, never the due date.
  Settled or suspended balances receive
  no ineligible reminder.
end note

note bottom of UC14
  Notification read/handled state is
  separate from payment or issue resolution.
end note

@enduml
