' TurbineH: 18 use cases (UC-01..UC-18), in four views of the same system.
' 18 use cases, renumbered UC-01..UC-18 from the 24-case draft (see use-case-specification.md, section 2).
' Absorbed original cases: UC-03, UC-05, UC-07, UC-09, UC-11, UC-19. No functional scope removed.
' Repeated ellipses are the same case; see the Markdown contracts for branches.

@startuml use-case-diagram-1-administration
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam note {
  BackgroundColor #FDE2B8
  BorderColor #2B3E6A
}
skinparam arrow {
  Color #2B3E6A
}
title View 1 - Access and administration

actor "Operational User\n(Reader / Assigned Staff)" as OpUser
actor "Administrator" as Admin
actor "Super Administrator" as SuperAdmin
actor "Time" as Time <<timer>>
actor "Communication Service\n(Email / WhatsApp, simulated)" as CommSrv <<system>>

rectangle "TurbineH Invoicing & Collections System" {
  usecase "UC-01 Access the internal\napplication" as UC01
  usecase "UC-03 Administer staff access\nand customer assignments" as UC03
  usecase "UC-12 Consult financial\ndashboard and reports" as UC12
  usecase "UC-13 Configure billing and\nautomation policies" as UC13
  usecase "UC-14 Supervise audit,\nbackups and recovery" as UC14
  usecase "UC-18 Close or reopen an\nadministrative period" as UC18
}

Admin -|> OpUser
SuperAdmin -|> Admin
OpUser --> UC01
Admin --> UC03
SuperAdmin --> UC03
Admin --> UC12
Admin --> UC18
SuperAdmin --> UC13
SuperAdmin --> UC14
Time --> UC14 : scheduled backup
Time --> UC12 : authorised summary
UC01 --> CommSrv : recovery email
UC03 --> CommSrv : activation
UC12 --> CommSrv : internal summary

note bottom of UC03
  Account changes require the specific
  FR6.3 grant; assignments require
  Administrator authority.
end note

note bottom of UC14
  Audit is read-only; only Super Administrator
  can restore. Time only creates backups.
  NFR-05, NFR-06
end note

@enduml

@startuml use-case-diagram-2-customers
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam note {
  BackgroundColor #FDE2B8
  BorderColor #2B3E6A
}
skinparam arrow {
  Color #2B3E6A
}
title View 2 - Customers and subscriptions

actor "Operational User\n(Reader / Assigned Staff)" as OpUser
actor "Administrator" as Admin
actor "Time" as Time <<timer>>
actor "External Application\n(Brain / API client)" as ExtApp

rectangle "TurbineH Invoicing & Collections System" {
  usecase "UC-02 Maintain customers\nand import records" as UC02
  usecase "UC-04 Manage subscriptions\nand annual rate reviews" as UC04
  usecase "UC-10 Record subscription\ncancellation" as UC10
  usecase "UC-11 Query outstanding obligations\nthrough the API" as UC11
  usecase "UC-05 Prepare, issue and\ndeliver an invoice" as UC05
  usecase "UC-17 Decide a sensitive\nfinancial approval" as UC17
}

Admin -|> OpUser
OpUser --> UC02
Admin --> UC02 : CSV branch
OpUser --> UC04
Admin --> UC04 : annual review
Time --> UC04 : review due
Admin --> UC10
ExtApp --> UC10 : intake only
ExtApp --> UC11
Admin --> UC17
UC10 ..> UC11 : <<include>>
UC05 ..> UC04 : <<extend>>\n(initial proration due)
UC17 ..> UC04 : <<extend>>\n(rate or commercial approval)

note bottom of UC02
  CSV import remains an
  Administrator-only branch.
end note

note bottom of UC10
  Cancellation stops future recurrence;
  previous debt remains collectible.
  C4; FR4, FR4.1
end note

@enduml

@startuml use-case-diagram-3-invoicing
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam note {
  BackgroundColor #FDE2B8
  BorderColor #2B3E6A
}
skinparam arrow {
  Color #2B3E6A
}
title View 3 - Invoicing

actor "Operational User\n(Reader / Assigned Staff)" as OpUser
actor "Administrator" as Admin
actor "Time" as Time <<timer>>
actor "Communication Service\n(Email / WhatsApp, simulated)" as CommSrv <<system>>

rectangle "TurbineH Invoicing & Collections System" {
  usecase "UC-05 Prepare, issue and\ndeliver an invoice" as UC05
  usecase "UC-06 Generate monthly\nrecurring invoices" as UC06
  usecase "UC-15 Correct an\nissued invoice" as UC15
  usecase "UC-17 Decide a sensitive\nfinancial approval" as UC17
}

Admin -|> OpUser
OpUser --> UC05
Admin --> UC15
Admin --> UC17
Time --> UC06
UC05 --> CommSrv
UC06 ..> UC05 : <<include>>
UC15 ..> UC05 : <<include>>
UC17 ..> UC05 : <<extend>>\n(sensitive proposal)
UC17 ..> UC15 : <<extend>>\n(correction threshold)

note bottom of UC05
  Preparation, issuance, PDF and delivery
  are phases of one contract. Included callers
  supply an authorised proposal.
  Failed dispatch never renumbers an invoice.
end note

note bottom of UC06
  Idempotent per subscription and period;
  recover only missing work. NFR-06
end note

@enduml

@startuml use-case-diagram-4-collections
!pragma layout smetana
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName SansSerif
skinparam defaultFontSize 14
skinparam backgroundColor #FFFFFF
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #2B3E6A
  FontColor #000000
}
skinparam note {
  BackgroundColor #FDE2B8
  BorderColor #2B3E6A
}
skinparam arrow {
  Color #2B3E6A
}
title View 4 - Collections and follow-up

actor "Operational User\n(Reader / Assigned Staff)" as OpUser
actor "Time" as Time <<timer>>
actor "Payment Provider\n(Stripe / Revolut, simulated)" as PayProv <<system>>
actor "Communication Service\n(Email / WhatsApp, simulated)" as CommSrv <<system>>

rectangle "TurbineH Invoicing & Collections System" {
  usecase "UC-05 Prepare, issue and\ndeliver an invoice" as UC05
  usecase "UC-07 Reconcile payments\nwith invoices" as UC07
  usecase "UC-08 Run reminders and\noverdue follow-up" as UC08
  usecase "UC-09 Review daily work\nand notifications" as UC09
  usecase "UC-16 Resolve a billing\nor delivery issue" as UC16
}

OpUser --> UC05 : delivery retry
OpUser --> UC07
OpUser --> UC09
OpUser --> UC16
Time --> UC07
Time --> UC08
UC05 --> CommSrv
UC08 --> CommSrv
UC07 --> PayProv
UC16 ..> UC05 : <<extend>>\n(delivery problem)
UC16 ..> UC07 : <<extend>>\n(reconciliation problem)

note bottom of UC08
  Customer terms override the default.
  C9 moves messages, never the due date.
  Settled or suspended balances receive
  no ineligible reminder.
end note

note bottom of UC09
  Notification read/handled state is
  separate from payment or issue resolution.
end note

@enduml
