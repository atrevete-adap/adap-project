@startuml sequence-monthly-generation
' TurbineH — Internal Invoicing & Payment Tracking System (Submission 2, task #48)
' Sequence diagram for UC-06 "Generate monthly recurring invoices".
' Professor's answer in #27: Time is not an actor; the scenario starts from the
' Scheduler component of the architecture (architecture.md, component diagram).
' Lifelines and operations follow the class diagram (PR #66). Kept short on
' purpose: paused/inactive subscriptions are filtered by findBillable().

skinparam boxPadding 10
skinparam participantPadding 10
skinparam shadowing false
hide footbox

skinparam participant {
    BackgroundColor #FFFFFF
    BorderColor #2B3E6A
    FontColor #000000
}
skinparam ArrowColor #2B3E6A
skinparam sequence {
    LifeLineBorderColor #2B3E6A
    GroupBorderColor #2B3E6A
}
skinparam note {
    BackgroundColor #FDE2B8
    BorderColor #2B3E6A
    FontColor #000000
}

title Sequence Diagram - Monthly Invoice Generation (UC-06; FR2.1, FR14.3)

box "Application Layer" #EBF0F5
    participant Sched as "scheduler : Scheduler" <<control>>
    participant Ctrl as "invoicingCtrl : InvoicingController" <<control>>
end box

box "Domain Layer" #FFFFFF
    participant Run as "run : AutomationRun"
    participant SubRepo as "subscriptionRepo : SubscriptionRepository" <<interface>>
    participant Sub as "sub : Subscription"
    participant InvRepo as "invoiceRepo : InvoiceRepository" <<interface>>
    participant Inv as "invoice : Invoice"
    participant Pdf as "pdfRenderer : PdfRenderer" <<interface>>
    participant Storage as "storage : DocumentStorage" <<interface>>
    participant Comm as "communication : CommunicationService" <<interface>>
end box

autonumber "<b>[00]"

[-> Sched : onTick(now)
activate Sched
note right of Sched
  Started by the system timer on the first
  day of the month (UC-13 policy). Runs with
  a system identity, not a staff session.
end note
Sched -> Ctrl : generateMonthlyInvoices(period)
activate Ctrl

create Run
Ctrl -> Run : <<create>> open(MONTHLY_INVOICING)

Ctrl -> SubRepo : findBillable(period)
activate SubRepo
SubRepo --> Ctrl : subscriptions
deactivate SubRepo

loop for each subscription
    Ctrl -> InvRepo : findForSubscriptionPeriod(sub, period)
    activate InvRepo
    InvRepo --> Ctrl : invoice [0..1]
    deactivate InvRepo

    alt already invoiced (FR14.3, no duplicates)
        Ctrl -> Run : recordItem(sub, SKIPPED)
    else not invoiced yet
        Ctrl -> Sub : buildRecurringProposal(period)
        activate Sub
        Sub --> Ctrl : proposal
        deactivate Sub

        create Inv
        Ctrl -> Inv : <<create>> createDraft(proposal)
        Ctrl -> Inv : issue(now)
        activate Inv
        note right of Inv
          Validates the draft, assigns the
          next number and freezes the data.
        end note
        Inv --> Ctrl : snapshot
        deactivate Inv

        alt draft not valid
            Ctrl -> Run : recordItem(sub, FAILED)
        else issued
            Ctrl -> Pdf : renderInvoice(snapshot)
            activate Pdf
            Pdf --> Ctrl : pdf
            deactivate Pdf
            Ctrl -> Storage : store(pdf)
            activate Storage
            Storage --> Ctrl : documentRef
            deactivate Storage
            Ctrl -> InvRepo : save(invoice)
            Ctrl -> Comm : send(invoice, pdf, EMAIL)
            Ctrl -> Run : recordItem(sub, CREATED)
        end
    end
end

Ctrl -> Run : finish()
Ctrl --> Sched : run
deactivate Ctrl
deactivate Sched

note over Sched, InvRepo
  Recovery (1a): after an outage the Scheduler calls
  generateMonthlyInvoices() again for the missed period.
  Step [06] skips invoices already issued, so only the
  missing ones are created. If any item failed, staff
  are notified (UC-14).
end note

@enduml
